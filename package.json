{
  "name": "ruangnilai",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "build:standalone": "tsc -b && vite build --mode standalone && node scripts/copy-standalone.mjs",
    "test:standalone": "node --import tsx tests/standalone.mjs",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.mjs",
    "format": "prettier --write src server scripts tests *.json *.ts *.md",
    "format:check": "prettier --check src server scripts tests *.json *.ts *.md"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
